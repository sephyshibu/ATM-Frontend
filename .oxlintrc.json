{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": [
      "warn",
      {
        "ignoreTypes": true
      }
    ],
    "max-lines": [
      "warn",
      {
        "max": 700,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "regex": "^@/(pages|components)/",
                "allowTypeImports": true,
                "message": "lib/ holds data and rules: it never imports UI (components/ or pages/)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "regex": "^@/pages/",
                "message": "components/ is shared UI: move what you need out of pages/ (components/common or lib/)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}